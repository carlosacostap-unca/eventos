<bpmndi:BPMNEdge id="consulta_flujo_9_di" bpmnElement="consulta_flujo_9"><di:waypoint x="1362" y="486"/><di:waypoint x="1362" y="530"/><bpmndi:BPMNLabel><dc:Bounds x="1371" y="494" width="80" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
