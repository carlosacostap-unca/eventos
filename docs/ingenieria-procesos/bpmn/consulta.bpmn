<bpmndi:BPMNEdge id="consulta_flujo_3_di" bpmnElement="consulta_flujo_3"><di:waypoint x="777" y="486"/><di:waypoint x="777" y="552"/><bpmndi:BPMNLabel><dc:Bounds x="786" y="505" width="80" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="consulta_flujo_4_di" bpmnElement="consulta_flujo_4"><di:waypoint x="803" y="460"/><di:waypoint x="900" y="460"/><bpmndi:BPMNLabel><dc:Bounds x="811.5" y="430" width="80" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="consulta_flujo_5_di" bpmnElement="consulta_flujo_5"><di:waypoint x="972" y="420"/><di:waypoint x="972" y="220"/></bpmndi:BPMNEdge>
