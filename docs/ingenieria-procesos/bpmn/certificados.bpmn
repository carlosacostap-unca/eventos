<bpmndi:BPMNEdge id="certificados_flujo_9_di" bpmnElement="certificados_flujo_9"><di:waypoint x="1362" y="500"/><di:waypoint x="1362" y="552"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
