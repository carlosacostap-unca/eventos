# Únicas credenciales necesarias de PocketBase
POCKETBASE_URL=https://pocketbase.example.com
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=cambiar-por-la-clave-del-superusuario

# Secretos propios de Next.js (mínimo 32 caracteres)
SESSION_SECRET=generar-un-secreto-aleatorio-de-al-menos-32-caracteres
INTERNAL_JOBS_SECRET=generar-otro-secreto-aleatorio-de-al-menos-32-caracteres

# Correo SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Eventos <eventos@example.com>

# URL pública de Next.js
APP_URL=http://localhost:3000
